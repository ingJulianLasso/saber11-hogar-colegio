# Datos crudos y entornos virtuales quedan fuera. Excepciones: los dos recortes del ICFES
# que leen el cuaderno y el script de R, para reproducir sin descargar, y data/agregados/,
# que guarda solo los agregados que el dashboard lee desde el repositorio.
data/*
!data/.gitkeep
!data/agregados/
*.parquet
*.csv
!data/agregados/*.csv
!data/agregados/*.parquet
!data/saber11-20224.parquet
!data/saber11-serie.parquet
.venv/

# Cachés de Python y de pytest.
__pycache__/
.pytest_cache/
